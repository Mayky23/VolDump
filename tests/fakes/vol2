#!/usr/bin/env bash
# Volatility 2 simulado para las pruebas de VolDump.
#
# Variables de control:
#   FAKE_OS      windows (defecto), linux, mac o none
#   FAKE_FAIL2   plugins que deben fallar, separados por comas
#   FAKE_LOG     fichero donde se registra cada invocación

echo "Volatility Foundation Volatility Framework 2.6.1" >&2
printf 'vol2 %s\n' "$*" >>"${FAKE_LOG:-/dev/null}"

if [[ " $* " == *" -h "* ]]; then
    echo "Usage: Volatility - A memory forensics analysis platform."
    exit 0
fi

if [[ " $* " == *" --info "* ]]; then
    cat <<'INFO'

Profiles
--------
Win10x64              - A Profile for Windows 10 x64
Win10x64_14393        - A Profile for Windows 10 x64 (10.0.14393.0 / 2016-07-16)
Win10x64_19041        - A Profile for Windows 10 x64 (10.0.19041.0 / 2020-04-17)
Win7SP0x64            - A Profile for Windows 7 SP0 x64
Win7SP1x64            - A Profile for Windows 7 SP1 x64
Win7SP1x64_23418      - A Profile for Windows 7 SP1 x64 (6.1.7601.23418 / 2016-04-09)
WinXPSP2x86           - A Profile for Windows XP SP2 x86

Address Spaces
--------------
FileAddressSpace          - This is a direct file AS.

Plugins
-------
cmdline                    - Display process command-line arguments
cmdscan                    - Extract command history by scanning for _COMMAND_HISTORY
connscan                   - Pool scanner for tcp connections
filescan                   - Pool scanner for file objects
handles                    - Print list of open handles for each process
iehistory                  - Reconstruct Internet Explorer cache / history
imageinfo                  - Identify information for the image
malfind                    - Find hidden and injected code
netscan                    - Scan a Vista (or later) image for connections and sockets
pslist                     - Print all running processes by following the EPROCESS lists
psscan                     - Pool scanner for process objects
pstree                     - Print process list as a tree
shellbags                  - Prints ShellBags info
sockets                    - Print list of open sockets

Scanner Checks
--------------
CheckPoolSize              - Check pool block size
INFO
    exit 0
fi

plugin=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --plugins=*|--profile=*) shift ;;
        -f) shift 2 ;;
        *) plugin="$1"; shift; break ;;
    esac
done

if [[ ",${FAKE_FAIL2:-}," == *",${plugin},"* ]]; then
    echo "ERROR   : volatility.debug    : No suitable address space mapping found" >&2
    exit 1
fi

case "${plugin}" in
    imageinfo)
        if [[ "${FAKE_OS:-windows}" == windows ]]; then
            echo "          Suggested Profile(s) : Win7SP1x64, Win7SP0x64, Win2008R2SP0x64"
        else
            echo "          Suggested Profile(s) : No suggestion (Instantiated with WinXPSP2x86)"
        fi
        ;;
    *)
        printf 'Offset(V)  Name  PID\n0x8000  System  4\n# %s %s\n' "${plugin}" "$*"
        ;;
esac
